#--------------------------------------
# Configuração do PostgreSQL
#--------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=validation-flow
DATABASE_USER=validation_flow
DATABASE_PASSWORD=senha_forte_do_banco

#--------------------------------------
# API key estática (fixa o tenant e os escopos; enviada no header X-API-Key)
#--------------------------------------
API_KEY=chave-de-desenvolvimento
API_KEY_TENANT=dev
API_KEY_SCOPES=flow:read,flow:write,flow:activate,validation:read,validation:execute,provider:read,provider:admin

#--------------------------------------
# Providers externos: configurados por tenant na tabela provider_config (habilitar, base_url, timeouts).
# Sem linha ou enabled=false => PROVIDER_DISABLED. Cache: app.providers.config-cache-ttl (PT30S).
#--------------------------------------
